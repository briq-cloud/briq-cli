{
  "name": "@briq-cloud/cli",
  "version": "0.1.2",
  "description": "The briq command line: run databases, sandboxes and any OCI image for your agents, fork a stack per git branch.",
  "keywords": [
    "briq",
    "cli",
    "agents",
    "mcp",
    "postgres",
    "database",
    "branch",
    "fork",
    "sandbox",
    "dev-environments"
  ],
  "homepage": "https://briq.cloud/docs/cli",
  "bugs": {
    "email": "hello@briq.cloud"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briq-cloud/briq-cli.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "briq": "dist/index.js"
  },
  "files": ["dist", "LICENSE"],
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node build.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@briq/public": "workspace:*",
    "@briq/sdk": "workspace:*",
    "esbuild": "0.25.12",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
